# ==============================================
# CONFIGURAÇÕES DO SERVIDOR
# ==============================================
PORT=3001
HOST=0.0.0.0

# ==============================================
# BANCO DE DADOS POSTGRESQL
# ==============================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=backend
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://admin:sua_senha_aqui@localhost:5432/backend?schema=public

# ==============================================
# AUTENTICAÇÃO (BETTER AUTH / JWT)
# ==============================================
BETTER_AUTH_SECRET=seu_secret_gerado_melhor_auth_aqui
BETTER_AUTH_URL=http://localhost:3001
JWT_SECRET_ACCESS_TOKEN=troque_por_um_segredo_forte
JWT_ACCESS_TOKEN_EXPIRATION=15d

# ==============================================
# SEGURANÇA E CORS (Origens separadas por vírgula)
# ==============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5004,http://192.168.1.9:5004

# ==============================================
# INTEGRAÇÕES E APIS EXTERNAS
# ==============================================
TOMTICKET_BEARER_TOKEN=seu_token_tomticket_aqui
