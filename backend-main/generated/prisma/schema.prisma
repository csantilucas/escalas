model Atendimento {
  id              String  @id @default(uuid())
  ticketZpro      String? // ID/Código do Ticket ZPro
  ticketTomticket String? // ID/Código do Ticket Tomticket
  sincronizado    Boolean @default(false)
  clienteId       String?
  cnpj            String?
  atendente       String?
  protocolo       String?
  nomeContato     String?
  tipoAtendimento String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("atendimentos")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model DistribuicaoLog {
  id               String  @id @default(uuid())
  ticketId         String? // ID/Código do Ticket ZPro
  clienteId        String? // ID do Cliente
  numero           String? // Telefone/WhatsApp
  pushName         String? // Nome de exibição do contato
  departamento     String? // Departamento de entrada
  fila             String? // Fila solicitada
  equipeNome       String? // Nome da equipe selecionada
  queueId          Int? // ID da fila Z-PRO
  queueName        String? // Nome da fila Z-PRO
  userId           Int? // ID do usuário/atendente no Z-PRO
  atendenteNome    String? // Nome do analista atribuído
  atendenteEmail   String? // E-mail do analista
  atendenteSlack   String? // Slack ID do analista
  modoDistribuicao String // Modo (ex: ponderado_menor_carga, fallback_sequencial_round_robin)
  pontuacaoCarga   Int?    @default(0)
  metricas         Json? // Cargas do analista: { abertos, pendentes, fechadosHoje }
  sucesso          Boolean @default(true)
  status           String  @default("open") // open | pending | error
  detalhes         Json? // Payload completo / metadados adicionais

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("distribuicoes_logs")
}

model EquipePlantao {
  id        String  @id @default(uuid())
  nome      String
  descricao String?
  cor       String?
  ativo     Boolean @default(true)

  // Roteamento e Filas do Z-PRO
  queueId       Int?
  queueName     String?
  departamentos String[] @default([])
  isFallback    Boolean  @default(false)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  membros   MembroEquipe[]

  @@map("equipes_plantao")
}

model MembroEquipe {
  id       String  @id @default(uuid())
  equipeId String
  userId   String
  cargo    String? @default("plantonista")

  // Fallback Sequencial & Prioridade
  ordemSequencial     Int       @default(0)
  ultimoAtendimentoEm DateTime?
  pesoPrioridade      Int       @default(0)

  // Turnos de Trabalho (ex: [{"inicio": "08:10", "fim": "12:20"}, {"inicio": "14:00", "fim": "18:00"}])
  turnos              Json?
  margemInicioMinutos Int   @default(5)
  margemFimMinutos    Int   @default(5)

  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipe EquipePlantao @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([equipeId, userId])
  @@map("membros_equipe")
}

model Plantonistas {
  id           String    @id @default(uuid())
  nome         String
  posicao      Int       @default(0)
  proxima_data DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  registros Registros[]
}

model Registros {
  id         String   @id @default(uuid())
  plantao_id String
  user_id    String
  data       DateTime
  startTime  DateTime
  endTime    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plantao Plantonistas @relation(fields: [plantao_id], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// prisma/schema.prisma
generator client {
  provider = "prisma-client-js" // Corrigido para prisma-client-js
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ExternalToken {
  id          String   @id @default(uuid())
  serviceName String   @unique
  token       String
  apiUrl      String? // URL customizada da API do serviço
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("external_tokens")
}

// prisma/schema.prisma

model TomticketReportCache {
  id        String   @id @default(uuid())
  startDate String // Ex: "2026-07-01"
  endDate   String // Ex: "2026-07-27"
  data      Json // Salva o retorno completo (array de operadores e métricas)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startDate, endDate]) // Garante um cache único por período
  @@map("tomticket_report_caches")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  pass          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 1. Nível de Acesso (Permissões no Sistema)
  role NivelAcesso @default(comum)

  // 2. Tipo de Usuário (Função Operacional: Atendente ou Comum)
  typeUser TipoUsuario @default(atendente)

  // 3. Campos exclusivos para quem é Atendente
  id_atendente  String? @unique
  zproId        Int?    @unique
  slackId       String?
  isPlantonista Boolean @default(false)
  posicao       Int?    @default(0)

  plantao       Plantonistas?
  registros     Registros[]
  membrosEquipe MembroEquipe[]
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

enum NivelAcesso {
  admin
  gestor
  comum
}

enum TipoUsuario {
  atendente
  comum
}
