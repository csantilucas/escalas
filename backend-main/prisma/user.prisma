model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique 
  emailVerified Boolean      @default(false)
  image         String?
  pass          String?
  createdAt     DateTime     @default(now()) 
  updatedAt     DateTime     @updatedAt     
  
  // 1. Nível de Acesso (Permissões no Sistema)
  role          NivelAcesso  @default(comum)
  
  // 2. Tipo de Usuário (Função Operacional: Atendente ou Comum)
  typeUser      TipoUsuario  @default(atendente)
  
  // 3. Campos exclusivos para quem é Atendente
  id_atendente  String?      @unique
  zproId        Int?         @unique
  slackId       String?
  isPlantonista Boolean      @default(false)
  posicao       Int?         @default(0)

  plantao       Plantonistas?
  registros     Registros[] 
  membrosEquipe MembroEquipe[]
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}
  
enum NivelAcesso {
  admin
  gestor
  comum
}

enum TipoUsuario {
  atendente
  comum
}